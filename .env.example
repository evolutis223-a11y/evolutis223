# Copier en .env (jamais commité) et remplir localement.

# PostgreSQL — instance locale de dev pour l'instant, puis Neon en production (§3.6)
DATABASE_URL="postgresql://user:password@localhost:5432/evolutis223"

# Session — clé de signature des cookies (générer une valeur aléatoire longue, ex: openssl rand -base64 32)
SESSION_SECRET=""

# Mobile Money — agrégateur (§12), clés de test uniquement pendant le développement
PAYMENT_AGGREGATOR_API_KEY=""

# Stockage fichiers — Vercel Blob (§3.2, tranché 2026-07-30), logos/modèles uploadés par les
# clients sur le parcours maquette public (§10ter). Créer un store Blob sur le dashboard
# Vercel du projet, copier le token "BLOB_READ_WRITE_TOKEN" généré.
BLOB_READ_WRITE_TOKEN=""
