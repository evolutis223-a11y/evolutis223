# Copier en .env (jamais commité) et remplir localement.

# PostgreSQL — instance locale de dev pour l'instant, puis Neon en production (§3.6)
DATABASE_URL="postgresql://user:password@localhost:5432/evolutis223"

# Session — clé de signature des cookies (générer une valeur aléatoire longue, ex: openssl rand -base64 32)
SESSION_SECRET=""

# Mobile Money — agrégateur Jemenipay (§12, Orange Money/Moov Money), tranché 2026-08-07.
# Clés visibles sur le tableau de bord Jemenipay > Paramètres > Marchands > Clés API.
# Utiliser les clés "Mode Test" (pk_test_...) tant que SITE_OUVERT_AU_PUBLIC n'est pas "true".
JEMENIPAY_API_KEY=""
JEMENIPAY_ACCESS_TOKEN=""
JEMENIPAY_SECRET_KEY=""
# "sandbox" (défaut) ou "live" — ne passer à "live" qu'avec les clés live, juste avant l'ouverture publique.
JEMENIPAY_ENV="sandbox"
# Secret affiché une seule fois à la création du webhook (Jemenipay > Webhooks > Nouveau webhook).
JEMENIPAY_WEBHOOK_SECRET=""

# Stockage fichiers — Vercel Blob (§3.2, tranché 2026-07-30), logos/modèles uploadés par les
# clients sur le parcours maquette public (§10ter). Créer un store Blob sur le dashboard
# Vercel du projet, copier le token "BLOB_READ_WRITE_TOKEN" généré.
BLOB_READ_WRITE_TOKEN=""

# Verrou d'accès public (2026-08-02) — le site public (boutique, maquette, configurateur, suivi)
# reste fermé au grand public tant que SITE_OUVERT_AU_PUBLIC n'est pas "true". En attendant,
# définir SITE_MOT_DE_PASSE_APERCU pour accéder via ?apercu=<mot de passe> (une fois, cookie 30j).
SITE_OUVERT_AU_PUBLIC=""
SITE_MOT_DE_PASSE_APERCU=""
